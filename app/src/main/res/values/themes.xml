<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SenAnnonces" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/acid</item>
        <item name="colorPrimaryVariant">@color/acid_dim</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/acid</item>
        <item name="colorSecondaryVariant">@color/acid_dim</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Theme.SenAnnonces.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="Widget.SenAnnonces.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/acid</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.SenAnnonces.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Widget.SenAnnonces.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="hintTextColor">@color/acid</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.SenAnnonces.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.SenAnnonces.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/off_black</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="TextAppearance.SenAnnonces.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SenAnnonces.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SenAnnonces.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.SenAnnonces.Accent" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/acid</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
